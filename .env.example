# ── Demo mode (fictional canned results; no keys, no model calls) ──
# KATO8_DEMO=1
# Ignored automatically when CLERK_SECRET_KEY is set.

# ── Auth (Clerk). The build stops without CLERK_PUBLISHABLE_KEY unless KATO8_DEMO=1. ──
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# ── AI. Server side only; the browser never sees it. ──
ANTHROPIC_API_KEY=your_api_key_here
# ANTHROPIC_MODEL=

# ── Suite links (optional overrides; defaults live in @kato8/core) ──
# KATO8_URL_HUB=https://hub.example.com
